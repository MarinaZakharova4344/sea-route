# Секрет для подписи сессий (любая длинная случайная строка).
# Скопируйте в .env и замените значение.
SESSION_SECRET=change-me-to-a-long-random-string
# Путь к файлу базы данных (по умолчанию data/sea-route.db)
# DATABASE_PATH=data/sea-route.db
# Часовой пояс компании: от него зависит, какой день считается «сегодняшним» (сроки, просрочки, «не обновлялась N дн.»).
# По умолчанию Europe/Moscow.
# APP_TIMEZONE=Europe/Moscow
